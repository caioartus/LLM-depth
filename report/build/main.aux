\@writefile{toc}{\contentsline {subsection}{\numberline {A.2}Coordinate check for CompleteP}{8}{subsection.A.2}\protected@file@percent }
\newlabel{app:coord}{{A.2}{8}{Coordinate check for CompleteP}{subsection.A.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Coordinate check against depth ($L = 2$ to $64$ at $d = 256$): mean $|\text  {output}|$ of each activation at each of 10 training steps (constant learning rate $2^{-8}$, micro-batch 8, mean over 3 seeds; log scale). Attention and MLP values are averaged over all blocks and measured before the residual multiplier. Because of pre-LayerNorm, each branch sees a normalised input, so the SP branch outputs stay roughly flat in depth. The SP residual stream after the last block (before the final LayerNorm) still grows with depth, by about $20\times $ from $L = 2$ to $L = 64$ at step 10, because it sums $L$ unscaled branch outputs. With CompleteP's $L^{-1}$ residual scaling it stays flat.}}{8}{figure.caption.19}\protected@file@percent }
\newlabel{fig:coord_check_depth}{{3}{8}{Coordinate check against depth ($L = 2$ to $64$ at $d = 256$): mean $|\text {output}|$ of each activation at each of 10 training steps (constant learning rate $2^{-8}$, micro-batch 8, mean over 3 seeds; log scale). Attention and MLP values are averaged over all blocks and measured before the residual multiplier. Because of pre-LayerNorm, each branch sees a normalised input, so the SP branch outputs stay roughly flat in depth. The SP residual stream after the last block (before the final LayerNorm) still grows with depth, by about $20\times $ from $L = 2$ to $L = 64$ at step 10, because it sums $L$ unscaled branch outputs. With CompleteP's $L^{-1}$ residual scaling it stays flat}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Coordinate check against width ($d = 256$ to $1024$ at $L = 2$), same setup as Figure~\ref {fig:coord_check_depth}. Under SP the attention branch, MLP branch and last-block residual stream grow with width at every step after the first, by roughly $7$ to $13\times $ over a $4\times $ increase in $d$ at step 10. SP uses the same learning rate for every width, so each update of a hidden matrix changes its output by an amount that grows with $d$. CompleteP scales the hidden-matrix learning rate by $m_d^{-1}$, and all its activations stay flat in width; the remaining variation is mostly in the first few steps. The token embedding is nearly flat in both parameterisations. The SP logits vary irregularly with width rather than growing steadily.}}{8}{figure.caption.20}\protected@file@percent }
\newlabel{fig:coord_check_width}{{4}{8}{Coordinate check against width ($d = 256$ to $1024$ at $L = 2$), same setup as Figure~\ref {fig:coord_check_depth}. Under SP the attention branch, MLP branch and last-block residual stream grow with width at every step after the first, by roughly $7$ to $13\times $ over a $4\times $ increase in $d$ at step 10. SP uses the same learning rate for every width, so each update of a hidden matrix changes its output by an amount that grows with $d$. CompleteP scales the hidden-matrix learning rate by $m_d^{-1}$, and all its activations stay flat in width; the remaining variation is mostly in the first few steps. The token embedding is nearly flat in both parameterisations. The SP logits vary irregularly with width rather than growing steadily}{figure.caption.20}{}}
