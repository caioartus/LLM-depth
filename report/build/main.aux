\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Left:} final validation loss for each shape at a fixed compute budget of $8.48\times 10^{17}$ FLOPs, ordered from deep and narrow to shallow and wide. SP is shown in blue and CompleteP in orange. Dashed lines use the learning rate tuned at \ensuremath  {512{\times }16} and transferred to all shapes; solid lines use a learning rate tuned per shape with short tuning runs (10\% of the tokens). Error bars show $\pm $ the pooled seed standard deviation (0.0076, from 3 seeds per parameterisation at \ensuremath  {512{\times }16}). \textbf  {Right:} SP at \ensuremath  {256{\times }64}, validation loss at three peak learning rates, relative to the loss at $6\times 10^{-4}$ (negative means better). Circles mark the best learning rate in each setting. Tuning runs with the default 10\% warmup prefer the lowest learning rate. Full-length runs prefer the highest, and so do tuning runs with a 50\% warmup.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:main}{{2}{4}{\textbf {Left:} final validation loss for each shape at a fixed compute budget of $8.48\times 10^{17}$ FLOPs, ordered from deep and narrow to shallow and wide. SP is shown in blue and CompleteP in orange. Dashed lines use the learning rate tuned at \sh {512}{16} and transferred to all shapes; solid lines use a learning rate tuned per shape with short tuning runs (10\% of the tokens). Error bars show $\pm $ the pooled seed standard deviation (0.0076, from 3 seeds per parameterisation at \sh {512}{16}). \textbf {Right:} SP at \sh {256}{64}, validation loss at three peak learning rates, relative to the loss at $6\times 10^{-4}$ (negative means better). Circles mark the best learning rate in each setting. Tuning runs with the default 10\% warmup prefer the lowest learning rate. Full-length runs prefer the highest, and so do tuning runs with a 50\% warmup}{figure.caption.4}{}}
